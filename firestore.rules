rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requester is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if requester owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User accounts collection
    match /users/{userId} {
      // Owner or Admin can read user details
      allow read: if isOwner(userId) || isAdmin();
      
      // New user registration (role must be 'user', cannot self-assign 'admin')
      allow create: if request.auth != null && 
                    request.auth.uid == userId &&
                    request.resource.data.role == 'user' &&
                    request.resource.data.checkingBalance >= 0 &&
                    request.resource.data.savingsBalance >= 0;
                    
      // Updates: owner can update profile fields, but only admin can freeze/unfreeze or change role
      allow update: if (isOwner(userId) && 
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.checkingBalance >= 0 &&
                        request.resource.data.savingsBalance >= 0) 
                    || isAdmin();
                    
      // Deletion: restricted to admins
      allow delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{txnId} {
      // Involved parties (sender or recipient) or admin can read transaction
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );

      // Create: Authenticated users can log transaction records
      allow create: if request.auth != null && 
                    request.resource.data.amount > 0 &&
                    request.resource.data.status in ['completed', 'pending', 'failed'];
                    
      // Transactions are immutable audit logs
      allow update, delete: if isAdmin();
    }
  }
}
